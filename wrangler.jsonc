{
  "name": "runbook-desk",
  "main": "worker.js",
  "account_id": "671415c7ecfa0bd6ad7e3ae53b1fab88",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"API_ORIGIN": "https://runbook-desk.onrender.com"},
  "routes": [{"pattern": "runbook.artemislab.co.uk", "custom_domain": true}],
